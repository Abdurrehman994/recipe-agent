# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Free tier: https://console.groq.com/keys   (used by --provider groq)
GROQ_API_KEY=

# Paid: https://console.anthropic.com/settings/keys   (used by --provider anthropic)
ANTHROPIC_API_KEY=

# Lehmus AI (University of Oulu), OpenAI-compatible. Portal: API URL (left sidebar) and API Keys.
LEHMUS_BASE_URL=
LEHMUS_API_KEY=
LEHMUS_MODEL=openai/gpt-oss-120b
LEHMUS_MODEL_LABEL=gpt-oss-120b
